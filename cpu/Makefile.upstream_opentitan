# Locate cocotb makefiles: try cocotb-config first, then fall back to python3.
COCOTB_MAKEFILES := $(shell cocotb-config --makefiles 2>/dev/null)
ifeq ($(COCOTB_MAKEFILES),)
COCOTB_MAKEFILES := $(shell python3 -c \
  "import cocotb, pathlib; print(pathlib.Path(cocotb.__file__).parent / 'share' / 'makefiles')" \
  2>/dev/null)
endif
ifeq ($(COCOTB_MAKEFILES),)
$(error "Cannot find cocotb. Run: conda activate <your_env>  or  pip install cocotb")
endif

include $(COCOTB_MAKEFILES)/Makefile.sim
