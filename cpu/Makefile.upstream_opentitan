# Makefile.upstream_opentitan
# ===========================
# Builds Ibex against a FRESH vendor pull of lowRISC/ibex master (see
# cpu/src_upstream/_UPSTREAM_PROVENANCE.txt for the pinned commit), with the
# EXACT official "opentitan" preset from their own ibex_configs.yaml — see
# cocotb_ibex_opentitan_upstream.sv for the parameter values and the
# "same canvas, different testbench" rationale. Nothing about sim_build/,
# sim_build_max/, sim_build_max_upstream/ is touched by this file.
#
# Usage:
#   make -f Makefile.upstream_opentitan          # build + run (MODULE=test_run_for_l8)
#
# First build takes 20-60+ min. Subsequent runs reuse sim_build_opentitan_upstream/Vtop.
#
# File list identical to Makefile.upstream (same RTL files regardless of
# parameter values) — generated from FuseSoC's manifest, see
# cpu/src_upstream/_diff_report.txt for what's new/removed vs the old vendor tree.

SIM            ?= verilator
TOPLEVEL_LANG  ?= verilog
TOPLEVEL        = cocotb_ibex
MODULE         ?= test_run_for_l8

# Separate build directory so this never touches any other sim_build*
SIM_BUILD      = sim_build_opentitan_upstream

